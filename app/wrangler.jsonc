// Cấu hình phát hành lên Cloudflare (Workers phục vụ file tĩnh — miễn phí).
// Phát hành: npm run deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "english-vocab",
  "compatibility_date": "2026-10-19",
  // Worker chỉ chạy cho /api/* (trợ lý AI, R8); mọi đường dẫn khác trả thẳng file tĩnh.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // App một trang: đường dẫn như /notebook trả về index.html để React Router xử lý.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Workers AI, gói miễn phí: 10.000 neuron/ngày cho cả tài khoản. Tài khoản Workers miễn phí vượt hạn mức
  // thì yêu cầu báo lỗi, không bị tính tiền. Lưu ý: nếu nâng lên gói Workers trả phí thì phần vượt sẽ bị tính tiền.
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    // Địa chỉ dự án Supabase (công khai), để Worker kiểm tra phiên đăng nhập bằng khóa công khai của dự án.
    "SUPABASE_URL": "https://fiaszihrpitcsdsqdgdu.supabase.co"
  }
}
